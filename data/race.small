global counter = 0;

function increment() {
    i = 0;
    while (i < 1000000) {
    counter = counter + 1;
    i = i + 1;
    }
    return 0;
}

function main() {
    spawn(thread1, increment());
    spawn(thread2, increment());
    join(thread1);
    join(thread2);
    r = counter;
    return r;
}